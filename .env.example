# Local development only. Copy to .env and replace the empty passwords.
# Use only letters, digits, hyphen, or underscore for both passwords and the RabbitMQ user.
# Different random hexadecimal values are suitable for both local passwords.
POSTGRES_PASSWORD=
RABBITMQ_USER=cityportal
RABBITMQ_PASSWORD=
CITY_TIME_ZONE=UTC
# Override both together only if this local Docker subnet conflicts with another network.
# COMPOSE_SUBNET=172.30.88.0/24
# PROXY_ADDRESS=172.30.88.10
