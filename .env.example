# Local development only. Copy to .env and replace the empty passwords.
# Use only letters, digits, hyphen, or underscore for both passwords and the RabbitMQ user.
# Different random hexadecimal values are suitable for both local passwords.
POSTGRES_PASSWORD=
RABBITMQ_USER=cityportal
RABBITMQ_PASSWORD=
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
CITY_TIME_ZONE=UTC
PUBLIC_ORIGIN=https://localhost:8443

# Optional Stage 6 integrations. Keep credentials in the deployment environment.
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
MCP_AUTHORITY=
MCP_CLIENT_ID=
# start-stand.py generates a separate pgAdmin password when unset.
PGADMIN_EMAIL=pgadmin@example.com
PGADMIN_PASSWORD=
# Set a real DNS hostname before using compose.public.yaml; keep PUBLIC_ORIGIN in sync.
# SITE_DOMAIN=portal.example.org
# Override both together only if this local Docker subnet conflicts with another network.
# COMPOSE_SUBNET=172.30.88.0/24
# PROXY_ADDRESS=172.30.88.10
