{
  "openapi": "3.1.1",
  "info": {
    "title": "CityPortal.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/system/info": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Returns public application metadata.",
        "operationId": "getSystemInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfoResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SystemInfoResponse": {
        "required": [
          "name",
          "stage"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "stage": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "Public application metadata for the frontend connection check."
      }
    }
  },
  "tags": [
    {
      "name": "System"
    }
  ]
}
