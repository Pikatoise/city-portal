{
  "name": "city-portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:city-portal": "node dist/city-portal/server/server.mjs",
    "generate:api": "ng-openapi-gen",
    "refresh:api": "node scripts/refresh-api.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "api:check": "node scripts/check-api.mjs",
    "prototype": "ng serve --configuration prototype --proxy-config proxy.conf.json --host 127.0.0.1 --port 4300"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/platform-server": "22.2.5",
    "@angular/router": "22.2.5",
    "@angular/ssr": "22.2.6",
    "express": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@tiptap/core": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "jsdom": "30.1.3",
    "ng-openapi-gen": "1.1.0",
    "prettier": "3.10.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^26.0.0",
    "npm": ">=11.0.0"
  }
}
