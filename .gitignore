## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Local configuration, frontend dependencies, and development certificates
.env.*
!.env.example
node_modules/
.angular/
dist/
coverage/
.local/
*.pfx
*.pem
*.key

# Private keys, certificate stores, and ASP.NET Core Data Protection keys
*.p12
*.p8
*.snk
*.jks
*.keystore
*.kdbx
id_rsa
id_dsa
id_ecdsa
id_ed25519
key-*.xml
DataProtection-Keys/
data-protection-keys/

# Local secret/configuration overrides; keep shared non-secret appsettings tracked
secrets.json
.secrets/
secrets/
appsettings.Local.json
appsettings.local.json
appsettings.*.Local.json
appsettings.*.local.json
.npmrc
.netrc
_netrc
.pgpass
.envrc
NuGet.Local.Config
nuget.local.config
*.pubxml.user
*.publishsettings

# Local IDE state and machine-specific connection settings
.vs/
.idea/
*.user
*.suo
.vscode/mcp.json
.mcp.local.json

# Runtime logs, crash dumps, and local database/backup copies
*.log
*.dmp
*.dump
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
backups/
