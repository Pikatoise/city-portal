{
	admin off
	auto_https disable_redirects
}

https://localhost:8443 {
	tls internal

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	@api path /api/* /health/* /openapi/* /scalar /scalar/*
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy frontend:4000
	}
}
