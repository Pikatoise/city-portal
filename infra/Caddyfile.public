{
	admin off
}

{$SITE_DOMAIN} {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	handle /setup {
		respond 404
	}

	@api path /rss.xml /.well-known/oauth-protected-resource/api/mcp /api/* /health/*
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy frontend:4000
	}
}
